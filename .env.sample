# Shared environment for local development on the host and in Docker Compose.
# Compose overrides connection URLs and paths for its internal network and mounts.
DOCSRS_PREFIX=ignored/cratesfyi-prefix
DOCSRS_POSTGRES_PORT=15432
DOCSRS_DATABASE_URL=postgresql://cratesfyi:password@localhost:${DOCSRS_POSTGRES_PORT}

# for local development with sqlx
DATABASE_URL=${DOCSRS_DATABASE_URL}

DOCSRS_LOG=docs_rs=debug,rustwide=info
# For staging: only watch/synchronize crates already in the crates table.
# Manually import or build a crate to opt it in. Ignored changes are not replayed.
DOCSRS_ONLY_EXISTING_CRATES=false
AWS_ACCESS_KEY_ID=cratesfyi
AWS_SECRET_ACCESS_KEY=secret_key
DOCSRS_S3_PORT=9000
DOCSRS_S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:${DOCSRS_S3_PORT}

DOCSRS_WEB_PORT=3000
# Browser tests against the local web server.
DOCSRS_WEB_SERVER_URL=http://127.0.0.1:${DOCSRS_WEB_PORT}


# build specific
DOCSRS_INCLUDE_DEFAULT_TARGETS=false
DOCSRS_DOCKER_IMAGE=ghcr.io/rust-lang/crates-build-env/linux-micro
SENTRY_ENVIRONMENT=dev
# To build with a PR that hasn't landed in a rust dist toolchain yet,
# you can set this to the git sha of a try build:
# https://forge.rust-lang.org/infra/docs/rustc-ci.html#try-builds
DOCSRS_TOOLCHAIN=nightly

# Maximum queued rebuilds for the registry watcher.
DOCSRS_MAX_QUEUED_REBUILDS=10
