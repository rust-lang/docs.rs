  "query": "SELECT\n                        c.name as \"name!\",\n                        r.version as \"version!\",\n                        r.rustdoc_status,\n                        cov.total_items\n                    FROM\n                        crates as c\n                        INNER JOIN releases AS r ON c.id = r.crate_id\n                        LEFT OUTER JOIN doc_coverage AS cov ON r.id = cov.release_id\n                ",
