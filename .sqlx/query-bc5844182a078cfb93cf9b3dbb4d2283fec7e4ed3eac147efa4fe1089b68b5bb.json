  "query": "SELECT\n             c.name as \"name: KrateName\",\n             r.version as \"version: Version\",\n             r.rustdoc_status\n          FROM\n             crates as c\n             INNER JOIN releases AS r ON c.id = r.crate_id\n          ORDER BY\n             c.name, r.version;\n        ",
